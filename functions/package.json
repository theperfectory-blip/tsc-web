{
  "name": "functions",
  "description": "Cloud Functions — TSC Web (notificaciones push FCM)",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test:emulator": "firebase emulators:exec --project demo-tsc-web --only firestore \"node test/verify-emulator.js\"",
    "test:rules": "firebase emulators:exec --project demo-tsc-web --only firestore \"node test/rules-teams.js && node test/rules-suite.js\"",
    "test:cleanup": "firebase emulators:exec --project demo-tsc-web --only firestore \"node test/cleanup-user.js\"",
    "test:rules:storage": "firebase emulators:exec --project demo-tsc-web --only storage \"node test/rules-storage.js\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  }
}
