{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tsc-src",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "tsc-src"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "tsc-2.0",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "tsc-src",
        "-l",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "tsc-emu-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/emu-start.mjs"
      ],
      "port": 8080
    },
    {
      "name": "tsc-emu",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "sandbox/site",
        "-l",
        "3001",
        "--no-port-switching"
      ],
      "port": 3001,
      "url": "http://localhost:3001"
    },
    {
      "name": "tsc-emu-dist",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/emu-dist.mjs"
      ],
      "port": 3001,
      "url": "http://localhost:3001"
    },
    {
      "name": "hosting-dist",
      "runtimeExecutable": "firebase",
      "runtimeArgs": [
        "emulators:start",
        "--only",
        "hosting",
        "--project",
        "tsc-web-yuna"
      ],
      "port": 5050
    }
  ]
}
