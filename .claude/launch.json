{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tsc-src",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "tsc-src"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "hosting-dist",
      "runtimeExecutable": "firebase",
      "runtimeArgs": ["emulators:start", "--only", "hosting", "--project", "tsc-web-yuna"],
      "port": 5050
    }
  ]
}
