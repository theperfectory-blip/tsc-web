rules_version = '2';

// ============================================================
//  Reglas de seguridad Firestore — TSC Web
//  Modelo de roles: public (anónimo) · president · admin
//  El rol y el teamId viven en users/{uid} y los asigna el admin.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()    { return request.auth != null; }
    function meExists()    { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function me()          { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin()     { return signedIn() && meExists() && me().role == 'admin'; }
    function isPresident() { return signedIn() && meExists() && me().role == 'president'; }

    // --- Colecciones del torneo: lectura PÚBLICA, escritura solo admin ---
    match /seasons/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /competitions/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /phases/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /matches/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /coins/{id}          { allow read: if true; allow write: if isAdmin(); }
    match /history/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /matchHistory/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /sorteo/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /sorteoEvents/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /palmares/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /palmares-comps/{id} { allow read: if true; allow write: if isAdmin(); }
    match /calDayLabels/{id}   { allow read: if true; allow write: if isAdmin(); }

    // --- Equipos: el presidente edita SU equipo ---
    match /teams/{teamId} {
      allow read: if true;
      allow update: if isAdmin()
                    || (isPresident() && me().teamId != null && string(me().teamId) == teamId
                        && me().lockEdits != true
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'logo']));
      allow create, delete: if isAdmin();
    }

    // --- Perfiles de usuario ---
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // Auto-registro: el usuario crea SU propio perfil, forzado a
      // presidente sin equipo (no puede auto-ascenderse a admin).
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'president'
                    && request.resource.data.teamId == null;

      // Edita su propio perfil — allowlist explícita (no blocklist): un
      // usuario solo puede tocar los campos de perfil + push/timezone de
      // abajo. Antes esto era "cualquier campo salvo role/teamId/lockEdits",
      // lo que también dejaba reescribir email/uid/createdAt sin querer.
      // fcmTokens/pushEnabled/pushPlatform/pushUpdatedAt: ver tsc-src/js/push.js
      // (Fase 8, notificaciones FCM) y docs/android-push-notifications.md.
      allow update: if isAdmin()
                    || (request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly([
                                'displayName', 'username', 'photoURL', 'timezone',
                                'fcmTokens', 'pushEnabled', 'pushPlatform', 'pushUpdatedAt'
                              ]));

      // Cada quien puede borrar su propia cuenta; el admin, cualquiera.
      allow delete: if isAdmin() || request.auth.uid == uid;
    }

    // --- Contadores de IDs enteros (emulan autoIncrement) ---
    // Solo admin: un presidente no debe poder manipular IDs
    match /_counters/{c} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // --- Pedidos de mejora PES5 (YunaCoins) --- lo crea quien tiene equipo asignado; lo aplica o rechaza el admin; el autor puede cancelarlo mientras esta pendiente.
    match /pedidos_pes5/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // Crea quien tenga equipo asignado, para SU equipo (no se mira el rol:
      // un admin que preside un club tambien pide).
      allow create: if signedIn() && meExists()
                    && me().teamId != null
                    && request.resource.data.uid == request.auth.uid
                    && string(me().teamId) == request.resource.data.teamId
                    && request.resource.data.estado == 'pendiente';

      // El admin lo aplica/rechaza. El autor solo puede cancelarlo mientras
      // esta pendiente, y solo tocando estado y canceladoEn.
      allow update: if isAdmin()
                    || (signedIn()
                        && resource.data.uid == request.auth.uid
                        && resource.data.estado == 'pendiente'
                        && request.resource.data.estado == 'cancelado'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'canceladoEn']));
      allow delete: if isAdmin();
    }

    // --- Reglas de precio YunaCoins / topes de temporada (slice R) ---
    // Cualquier usuario logueado las lee; solo el admin las escribe.
    match /pes5_config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- Plantillas PES5 publicadas por Luis (foto del equipo real) ---
    // Solo el admin las escribe (con la tool, leyendo su option file). El
    // presidente de ese equipo puede leer la suya; nadie mas.
    match /pes5_plantillas/{teamId} {
      allow read: if isAdmin() || (signedIn() && meExists() && me().teamId != null && string(me().teamId) == teamId);
      allow write: if isAdmin();
    }

    // --- Notificaciones push (Fase 8, backend FCM) ---
    // Solo el Admin SDK (Cloud Functions) escribe acá — las reglas de
    // cliente no importan para esas escrituras, pero se dejan explícitas
    // en "solo admin lee, nadie escribe desde cliente" por las dudas.
    // Ver functions/lib/notify.js y docs/android-push-notifications.md.
    match /notificationRuns/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /notificationEvents/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}
