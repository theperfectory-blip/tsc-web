rules_version = '2';

// ============================================================
//  Reglas de seguridad Firestore — TSC Web
//  Modelo de roles: public (anónimo) · president · admin
//  El rol y el teamId viven en users/{uid} y los asigna el admin.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()    { return request.auth != null; }
    function meExists()    { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function me()          { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin()     { return signedIn() && meExists() && me().role == 'admin'; }
    function isPresident() { return signedIn() && meExists() && me().role == 'president'; }

    // --- Temporadas archivadas (D8, MS-5.16) ---
    // archive/seasons = { numbers: [n…], compIds: [id…] }: temporadas cuyo
    // archivo fijo (tsc-src/data/temporadas) ya reemplazó a Firestore. Nadie
    // escribe documentos de esas temporadas, ni el admin. La lista solo crece.
    function archiveRef()   { return /databases/$(database)/documents/archive/seasons; }
    function archivedNums() { return exists(archiveRef()) ? get(archiveRef()).data.numbers : []; }
    function archivedComps(){ return exists(archiveRef()) ? get(archiveRef()).data.compIds : []; }
    // El campo `field` (número de temporada) no apunta a una archivada, ni en
    // el documento que queda ni en el que había.
    function notArchived(field, list) {
      return (request.resource == null || !(request.resource.data.get(field, null) in list))
          && (resource == null || !(resource.data.get(field, null) in list));
    }
    function seasonOpen(field) { return notArchived(field, archivedNums()); }

    match /archive/{doc} {
      allow read: if true;
      allow create: if isAdmin() && doc == 'seasons'
                    && request.resource.data.keys().hasOnly(['numbers', 'compIds', 'updatedAt'])
                    && request.resource.data.numbers is list && request.resource.data.compIds is list;
      allow update: if isAdmin() && doc == 'seasons'
                    && request.resource.data.keys().hasOnly(['numbers', 'compIds', 'updatedAt'])
                    && request.resource.data.numbers is list && request.resource.data.compIds is list
                    && request.resource.data.numbers.hasAll(resource.data.numbers)
                    && request.resource.data.compIds.hasAll(resource.data.compIds);
      allow delete: if false;
    }

    // --- Colecciones del torneo: lectura PÚBLICA, escritura solo admin ---
    match /seasons/{id}        { allow read: if true; allow write: if isAdmin() && seasonOpen('number'); }
    match /competitions/{id}   { allow read: if true; allow write: if isAdmin() && seasonOpen('season'); }
    match /phases/{id}         { allow read: if true; allow write: if isAdmin() && notArchived('compId', archivedComps()); }
    match /matches/{id}        { allow read: if true; allow write: if isAdmin() && seasonOpen('season'); }
    match /coins/{id}          { allow read: if true; allow write: if isAdmin() && seasonOpen('season'); }
    match /history/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /matchHistory/{id}   { allow read: if true; allow write: if isAdmin() && seasonOpen('seasonRef'); }
    match /sorteo/{id}         { allow read: if true; allow write: if isAdmin() && seasonOpen('season'); }
    match /sorteoEvents/{id}   { allow read: if true; allow write: if isAdmin() && seasonOpen('season'); }
    match /palmares/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /palmares-comps/{id} { allow read: if true; allow write: if isAdmin(); }
    match /calDayLabels/{id}   { allow read: if true; allow write: if isAdmin() && seasonOpen('season'); }

    // --- Equipos: el presidente edita SU equipo ---
    // Solo name y logo, y con valores validados (H-01: el logo se inserta
    // en <img src> del panel admin; un valor libre era XSS almacenado).
    // Cada campo se valida solo si cambia, para no bloquear la edición de
    // uno por un valor histórico del otro.
    function teamChanged(k) { return k in request.resource.data.diff(resource.data).affectedKeys(); }
    function validTeamName() {
      let n = request.resource.data.get('name', null);
      return !teamChanged('name')
          || (n is string && n.size() >= 1 && n.size() <= 40 && !n.matches('(?s).*[<>].*'));
    }
    function validTeamLogo() {
      let l = request.resource.data.get('logo', null);
      return !teamChanged('logo')
          || l == null
          || (l is string && l.size() < 500
              && l.matches('https://res[.]cloudinary[.]com/dnjijd8mx/[A-Za-z0-9_./,:%=+~-]+'));
    }

    // H-42 (MS-5.4): al renombrar, el presidente guarda el nombre que deja en
    // previousNames (el historial enlaza por nombre). Solo así: el nombre
    // anterior al frente y los que ya estaban, sin tocar nada más; y solo en
    // el mismo cambio que renombra. historyNames es la copia legacy en texto.
    // Renombrar sin previousNames sigue valiendo (APK 1.6.3 y anteriores).
    function validTeamPrevNames() {
      let oldPrev = resource.data.get('previousNames', []);
      let newPrev = request.resource.data.get('previousNames', null);
      return !teamChanged('previousNames')
          || (teamChanged('name') && resource.data.get('name', null) is string
              && oldPrev is list && newPrev is list && newPrev.size() <= 50
              && newPrev == [resource.data.name].concat(oldPrev));
    }
    function validTeamHistoryNames() {
      let newPrev = request.resource.data.get('previousNames', null);
      return !teamChanged('historyNames')
          || (teamChanged('previousNames') && newPrev is list
              && request.resource.data.get('historyNames', null) == newPrev.join(' → '));
    }

    match /teams/{teamId} {
      allow read: if true;
      allow update: if isAdmin()
                    || (isPresident() && me().teamId != null && string(me().teamId) == teamId
                        && me().lockEdits != true
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name', 'logo', 'previousNames', 'historyNames'])
                        && validTeamName()
                        && validTeamLogo()
                        && validTeamPrevNames()
                        && validTeamHistoryNames());
      allow create, delete: if isAdmin();
    }

    // --- Perfiles de usuario ---
    // Valores de los campos que escribe el propio usuario (H-06, slice 3.2).
    // displayName/username/photoURL terminan en el panel admin; aunque el
    // cliente escapa (3.1), las reglas acotan tipo, tamaño y formato.
    function cloudinaryUrl(v) {
      return v is string && v.size() < 500
          && v.matches('https://res[.]cloudinary[.]com/dnjijd8mx/[A-Za-z0-9_./,:%=+~-]+');
    }
    function validDisplayName(v) { return v is string && v.size() >= 1 && v.size() <= 64 && !v.matches('(?s).*[<>].*'); }
    // Mismo formato que impone profile.js (minúsculas, dígitos y _).
    function validUsername(v)    { return v == null || (v is string && v.matches('[a-z0-9_]{1,30}')); }
    function validPhotoURL(v)    { return v == null || cloudinaryUrl(v); }
    // Zona IANA (America/Santiago, Etc/GMT+3, UTC…).
    function validTimezone(v)    { return v == null || (v is string && v.size() <= 64 && v.matches('[A-Za-z0-9_+/-]+')); }
    function validIsoDate(v)     { return v is string && v.size() <= 40; }
    function userChanged(k)      { return k in request.resource.data.diff(resource.data).affectedKeys(); }
    function userField(k)        { return request.resource.data.get(k, null); }
    // Claims del token de la sesión (los pone Firebase Auth, no el cliente).
    function tokenEmail()        { return request.auth.token.get('email', null); }
    function tokenVerified()     { return request.auth.token.get('email_verified', false) == true; }
    // Admin asignando equipo (3.7, D7): solo a cuentas con email verificado.
    // `emailVerified` lo escribe el propio usuario y solo si su token lo
    // respalda (regla de update). El admin queda exento en su propia cuenta.
    function adminTeamChangeOk(uid) {
      return !userChanged('teamId')
          || userField('teamId') == null
          || resource.data.get('emailVerified', false) == true
          || request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // Auto-registro: el usuario crea SU propio perfil con los campos de
      // _loadProfile (tsc-src/js/auth.js), forzado a presidente sin equipo
      // y bloqueado (no puede auto-ascenderse ni nacer desbloqueado). El
      // uid y el email salen del token: no se pueden inventar.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly([
                         'uid', 'email', 'displayName', 'username', 'photoURL',
                         'timezone', 'role', 'teamId', 'lockEdits', 'createdAt'
                       ])
                    && request.resource.data.keys().hasAll(['uid', 'role', 'teamId', 'lockEdits'])
                    && userField('uid') == request.auth.uid
                    && userField('email') == request.auth.token.get('email', null)
                    && userField('role') == 'president'
                    && userField('teamId') == null
                    && userField('lockEdits') == true
                    && (!('displayName' in request.resource.data) || validDisplayName(userField('displayName')))
                    && validUsername(userField('username'))
                    && validPhotoURL(userField('photoURL'))
                    && validTimezone(userField('timezone'))
                    && (!('createdAt' in request.resource.data) || validIsoDate(userField('createdAt')));

      // Edita su propio perfil: allowlist explícita (no blocklist) de los
      // campos de perfil + push/timezone. Cada campo se valida solo si
      // cambia, para que un valor histórico no bloquee editar otro.
      // fcmTokens/pushEnabled/pushPlatform/pushUpdatedAt: ver tsc-src/js/push.js
      // (Fase 8, notificaciones FCM) y docs/android-push-notifications.md.
      allow update: if (isAdmin() && adminTeamChangeOk(uid))
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                              .affectedKeys().hasOnly([
                                'displayName', 'username', 'photoURL', 'timezone',
                                'fcmTokens', 'pushEnabled', 'pushPlatform', 'pushUpdatedAt',
                                'email', 'emailVerified'
                              ])
                        && (!userChanged('displayName')   || validDisplayName(userField('displayName')))
                        // El @usuario se reserva en usernames/{nombre} en el mismo lote (H-31).
                        && (!userChanged('username')      || (validUsername(userField('username'))
                              && (userField('username') == null
                                  || getAfter(/databases/$(database)/documents/usernames/$(userField('username'))).data.uid == request.auth.uid)))
                        // email: solo para alinearlo con el del token (cambio por verifyBeforeUpdateEmail).
                        && (!userChanged('email')         || userField('email') == tokenEmail())
                        && (!userChanged('emailVerified') || (userField('emailVerified') == true && tokenVerified()))
                        && (!userChanged('photoURL')      || validPhotoURL(userField('photoURL')))
                        && (!userChanged('timezone')      || validTimezone(userField('timezone')))
                        && (!userChanged('fcmTokens')     || (userField('fcmTokens') is list && userField('fcmTokens').size() <= 20))
                        && (!userChanged('pushEnabled')   || userField('pushEnabled') is bool)
                        && (!userChanged('pushPlatform')  || userField('pushPlatform') in ['android', 'ios', 'web'])
                        && (!userChanged('pushUpdatedAt') || validIsoDate(userField('pushUpdatedAt'))));

      // Cada quien puede borrar su propio perfil; el admin, cualquiera. No hay
      // botón de "borrar cuenta" en la app. El perfil guarda el vínculo con
      // el equipo (users.teamId) y los tokens FCM, así que borrarlo no deja
      // nada colgado. Lo que sí deja un perfil huérfano es borrar la cuenta
      // en Auth desde la consola: lo limpia la función onAuthUserDeleted.
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // --- Reserva de @usuario (H-31, slice 3.7) ---
    // usernames/{nombre} = { uid }. Se crea y se borra en el mismo lote que
    // actualiza users.username; la regla de users exige (getAfter) que la
    // reserva sea del propio usuario. Se puede leer un nombre (para avisar
    // "ya en uso") pero no listar la colección.
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin()
                    || (signedIn() && name.matches('[a-z0-9_]{1,30}')
                        && request.resource.data.keys().hasOnly(['uid'])
                        && request.resource.data.uid == request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // --- Contadores de IDs enteros (emulan autoIncrement) ---
    // Solo admin: un presidente no debe poder manipular IDs
    match /_counters/{c} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // --- Notificaciones push (Fase 8, backend FCM) ---
    // Solo el Admin SDK (Cloud Functions) escribe acá — las reglas de
    // cliente no importan para esas escrituras, pero se dejan explícitas
    // en "solo admin lee, nadie escribe desde cliente" por las dudas.
    // Ver functions/lib/notify.js y docs/android-push-notifications.md.
    match /notificationRuns/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /notificationEvents/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}
