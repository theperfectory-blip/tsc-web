rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Trofeos: lectura pública, escritura prohibida
    match /trophies/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Logos de equipos: ya no se usan (las subidas van a Cloudinary,
    // js/cloudinary.js). Antes cualquier cuenta registrada podía subir
    // archivos de cualquier tipo y tamaño (H-04, slice 3.3).
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Todo lo demás: denegado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
