<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
    <!-- Raíz dedicada para los APK que baja el auto-actualizador
         (AppUpdaterPlugin.java). La raíz "my_images" de arriba también
         matchearía (FileProvider matchea por prefijo de ruta canónica),
         pero esta es explícita, no depende de getExternalStorageDirectory()
         (deprecada desde API 29) y no expone toda la external storage solo
         para servir un APK. -->
    <external-files-path name="apk_updates" path="updates/" />
</paths>